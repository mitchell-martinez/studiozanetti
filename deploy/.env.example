# Docker image tags. Pin immutable image tags in production deployment automation.
STUDIOZANETTI_IMAGE=ghcr.io/mitchell-martinez/studiozanetti:main
WORDPRESS_IMAGE=wordpress:latest
MYSQL_IMAGE=mysql:8

# Existing production Docker resources adopted during the one-time split.
EDGE_NETWORK=edge
WORDPRESS_DATA_VOLUME=budgeto_wordpress-data
WORDPRESS_DB_DATA_VOLUME=budgeto_wordpress-db-data

# WordPress / MySQL
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=wordpress
MYSQL_USER=admin
MYSQL_PASSWORD=CHANGE_ME

# Studio Zanetti application
PORT=3000
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM_EMAIL=michael@example.com
SMTP_FROM_NAME=Studio Zanetti
SMTP_FROM_HEADER_EMAIL=info@example.com
SMTP_HELO_NAME=studiozanetti.com.au
FORM_RATE_LIMIT_WINDOW_MS=900000
FORM_RATE_LIMIT_MAX_REQUESTS=5
VSCO_WORKSPACE_SECRET_KEY=CHANGE_ME
VSCO_WORKSPACE_STUDIO_ID=CHANGE_ME
VSCO_WORKSPACE_TIMEOUT_MS=10000